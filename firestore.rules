rules_version = '2';
// Publish in Firebase console -> Firestore Database -> Rules (or `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}: {username, createdAt}. Only the signed-in owner may read / write their own document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // usernames/{lowercaseName}: {uid}. Reservation that keeps usernames unique (case-insensitive).
    //  - get: any signed-in user (needed to see if a name is free; list is NOT allowed, so names cannot be enumerated)
    //  - create: only if it does not exist yet, the id is lowercase and the stored uid is the caller's
    //  - delete: only the owner; no updates
    match /usernames/{name} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
                    && name == name.lower()
                    && request.resource.data.uid == request.auth.uid
                    && !exists(/databases/$(database)/documents/usernames/$(name));
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ranks/{uid}: multiplayer rank {tier, div, wins, matches, totalWins, updatedAt, username}.
    // Written ONLY by the game server (Admin SDK bypasses these rules); clients may read, never write.
    match /ranks/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Reserved for later (leaderboards etc.): add new collections here. Everything else is denied by default.
  }
}
